          "cachedResultName": "GPT-5.4-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Datos de la persona (fila de Google Sheets):\n- Nombre: {{ ($('Google Sheets Trigger').item.json['Nombre '] || '').trim() }}\n- Apellido: {{ $('Google Sheets Trigger').item.json['Apellido'] }}\n- Tipo de usuario: {{ $('Google Sheets Trigger').item.json['Tipo de Usuario'] }}\n- Correo: {{ $('Google Sheets Trigger').item.json['Correo electronico'] }}\n- ¿Quiere newsletter?: {{ $('Google Sheets Trigger').item.json['¿Quieres suscribirte al newsletter?'] }}\n\nRedacta el asunto y el cuerpo del correo para esta persona."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "Eres el asistente de una marca de audio que regala un rack de efectos a quien completa su formulario. Analiza los datos de la persona y redacta un correo breve, cálido y personal en español.\n\nReglas:\n- Saluda por su nombre (con mayúscula inicial).\n- Agradece su contacto y adapta un comentario breve a su tipo de usuario (productor, músico, DJ, etc.).\n- Incluye siempre, en su propia línea, exactamente: \"Link: ...\" (el enlace de descarga del rack de efectos).\n- No inventes descuentos, precios ni promesas.\n- Despídete con \"Saludos\".\n- Devuelve un asunto corto y el cuerpo en texto plano.\n- Esta persona NO quiere newsletter: el correo solo entrega el link del producto. No menciones el newsletter.",
          "maxTokens": 2000,
          "reasoning": {
            "reasoningOptions": {
              "effort": "low",
              "summary": "none"
            }
          },
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "email",
              "schema": "{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}},\"required\":[\"subject\",\"body\"],\"additionalProperties\":false}",
              "strict": true
            }
          }
        }
      },
